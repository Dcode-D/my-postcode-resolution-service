NODE_ENV=development
PORT=3000
# Nginx host binding. Use 0.0.0.0 for LAN/external access or 127.0.0.1 for local-only access.
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HOST_PORT=3000
# Nginx limits for POST /v1/postcode/resolve.
NGINX_RESOLVE_RATE=5r/s
NGINX_RESOLVE_BURST=10
NGINX_RESOLVE_CONNECTIONS_PER_IP=5
NGINX_RESOLVE_CONNECTIONS_TOTAL=50
NGINX_PROXY_TIMEOUT=120s
# Port exposed on your computer for PostgreSQL. Change if 5432 is already in use.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://postcode:postcode@localhost:5432/postcode_service
SANITIZE_ENABLED=true
MODELS_DEFAULT_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when MODELS_DEFAULT_PROVIDER=openai and no database provider is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
# Used when MODELS_DEFAULT_PROVIDER=deepseek and no database provider is enabled.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Cache the ordered database provider chain or environment fallback for five minutes.
PROVIDER_CONFIG_CACHE_TTL_SECONDS=300
# Cache country prompt and confidence settings read from PostgreSQL for five minutes.
RESOLUTION_SETTINGS_CACHE_TTL_SECONDS=300
# Cache successful model results by normalized address for 24 hours. Set TTL to 0 to disable.
MODEL_CACHE_TTL_SECONDS=86400
MODEL_CACHE_MAX_ENTRIES=1000
# Required for audit, statistics, and configuration-reload endpoints. Use at least 16 characters.
LOGS_API_KEY=
