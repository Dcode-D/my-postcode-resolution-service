NODE_ENV=development
PORT=3000
# Port exposed on your computer for the API container.
API_HOST_PORT=3000
# Port exposed on your computer for PostgreSQL. Change if 5432 is already in use.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://postcode:postcode@localhost:5432/postcode_service
SANITIZE_ENABLED=true
CONFIDENCE_THRESHOLD=0.80
MODELS_DEFAULT_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cache successful model results by normalized address for 24 hours. Set TTL to 0 to disable.
MODEL_CACHE_TTL_SECONDS=86400
MODEL_CACHE_MAX_ENTRIES=1000
# List-price estimates for gemini-3.5-flash Standard. Update when model/tier/pricing changes.
GEMINI_INPUT_PRICE_PER_MILLION_USD=1.5
GEMINI_CACHED_INPUT_PRICE_PER_MILLION_USD=0.15
GEMINI_OUTPUT_PRICE_PER_MILLION_USD=9
GEMINI_SEARCH_PRICE_PER_THOUSAND_USD=14
# Optional: overrides the built-in prompt. Supports {{address}}, {{phone}}, and {{detected_rules}}.
MODEL_PROMPT_TEMPLATE=
# Required to enable GET /v1/resolution-logs. Generate a unique secret with at least 16 characters.
LOGS_API_KEY=
