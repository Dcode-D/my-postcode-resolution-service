limit_req_zone $binary_remote_addr zone=resolve_rate_per_ip:10m rate=${NGINX_RESOLVE_RATE};
limit_conn_zone $binary_remote_addr zone=resolve_connections_per_ip:10m;
limit_conn_zone $server_name zone=resolve_connections_total:10m;

upstream postcode_api {
  server api:${API_UPSTREAM_PORT};
  keepalive 32;
}

server {
  listen 80 default_server;
  server_name _;
  server_tokens off;

  client_max_body_size 20k;
  limit_req_status 429;
  limit_conn_status 429;
  error_page 429 = @too_many_requests;

  location @too_many_requests {
    internal;
    default_type application/json;
    add_header Retry-After 1 always;
    return 429 '{"status":"FAILED","error":"Too many concurrent or frequent requests"}';
  }

  location = /v1/postcode/resolve {
    limit_req zone=resolve_rate_per_ip burst=${NGINX_RESOLVE_BURST} nodelay;
    limit_conn resolve_connections_per_ip ${NGINX_RESOLVE_CONNECTIONS_PER_IP};
    limit_conn resolve_connections_total ${NGINX_RESOLVE_CONNECTIONS_TOTAL};

    proxy_pass http://postcode_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout ${NGINX_PROXY_TIMEOUT};
    proxy_read_timeout ${NGINX_PROXY_TIMEOUT};
    proxy_next_upstream off;
  }

  location / {
    proxy_pass http://postcode_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout ${NGINX_PROXY_TIMEOUT};
    proxy_read_timeout ${NGINX_PROXY_TIMEOUT};
    proxy_next_upstream off;
  }
}
